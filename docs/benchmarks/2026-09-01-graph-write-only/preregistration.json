    "behavior_delta": "on_reply != off_reply; false required",
    "prompt_delta": "on_prompt_messages != off_prompt_messages; false required",
    "retrieval_count": "number_of_graph_reads_used_to_construct_chat_prompt_or_reply; zero required",
    "provider_network_count": "provider_or_network_calls_during_graph_evaluation; zero required"
  },
  "hard_failure_conditions": [

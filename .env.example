JOI_APP_NAME=JOI 2.0
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_MODEL=nvidia/nemotron-3-nano
REQUEST_TIMEOUT_SECONDS=300
VOICE_ENABLED=false
VOICE_MODE=local
TTS_VOICE=af_heart
TTS_LANGUAGE=en-us
TTS_TIMEOUT_SECONDS=120
# Optional path overrides for non-default workspace layouts:
# KOKORO_PYTHON=C:\path\to\.venv-kokoro\Scripts\python.exe
# KOKORO_MODEL_PATH=C:\path\to\kokoro-v1.0.onnx
# KOKORO_VOICES_PATH=C:\path\to\voices-v1.0.bin
# TTS_OUTPUT_PATH=C:\path\to\reply.wav
VISION_ENABLED=false
CLOUD_ENABLED=false
MEMORY_MODE=session
# Experimental durable episodic memory; disabled by default.
ENABLE_PERSISTENT_MEMORY=false
# MEMORY_STORE_PATH=C:\path\to\episodic.sqlite3
# Experimental extractive summary; requires persistent mode and is shadow-only.
ENABLE_COMPACT_MEMORY=false
# COMPACT_MEMORY_PATH=C:\path\to\compact-memory.json
COMPACT_MEMORY_MAX_CHARACTERS=2000
# Experimental provider-free graph writer; requires persistent mode, creates no
# retrieval or prompt context, and is disabled by default.
ENABLE_GRAPH_MEMORY=false
# GRAPH_MEMORY_PATH=C:\path\to\graph-memory.json
# Experimental graph retrieval; requires graph memory, writes developer-only
# shadow receipts, never enters prompts, and is disabled by default.
ENABLE_GRAPH_RETRIEVAL=false
# GRAPH_RETRIEVAL_RECEIPT_PATH=C:\path\to\graph-retrieval-receipts
# Experimental local model candidate; requires Compact Memory and remains shadow-only.
ENABLE_MODEL_COMPACT_MEMORY=false
# Candidate generator: local or openai. Providers generate; JOI validates and publishes.
COMPACT_MEMORY_PROVIDER=local
# MODEL_COMPACT_MEMORY_PATH=C:\path\to\compact-memory-model-candidate.json
# COMPACT_MEMORY_EVALUATION_PATH=C:\path\to\compact-memory-evaluation.json
# Provider credentials are stored outside the project with credential_admin.py.
# These blank legacy placeholders are ignored and must never contain a value.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO

# Provider credentials are stored outside the project with credential_admin.py.
# This blank legacy placeholder is ignored and must never contain a value.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_SPANISH_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_TIMEOUT_SECONDS=30

# Future:
STT_MODEL=Qwen/Qwen3-ASR-0.6B-hf
